ANTHROPIC_API_KEY=
# NetSuite OAuth 2.0 machine-to-machine (Client Credentials w/ certificate)
NS_ACCOUNT_ID=4204561-sb3          # Sandbox 3; lower-case, "-" instead of "_"
NS_CLIENT_ID=
NS_CERT_ID=
NS_PRIVATE_KEY_PATH=./netsuite_private.pem
NS_JWT_ALG=PS256                   # PS256 | ES256 | RS256
# Google Sheets (service account JSON; share the sheet with its email)
GOOGLE_SERVICE_ACCOUNT_FILE=./google_sa.json
# Created journals default to Pending Approval (1). Set 2 to auto-approve.
NS_APPROVAL_STATUS=1

# Jira (Journal Creation Request tickets). API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://redislabs.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
# Optional overrides of the workflow status names (defaults shown)
# JIRA_STATUS_START=Agent - Start Work
# JIRA_STATUS_WORKING=Agent - Working
# JIRA_STATUS_NEEDS_INFO=Needs Information
# JIRA_STATUS_FINISHED=Agent - Finished Work
